# Python environments and generated bytecode
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
/tmp/
*.pdf

# Local Tcl/Tk runtime prepared by prepare_tcl.py
.tcl-runtime/

# User state and logs
.localappdata/
*.log
.env
.env.*
!.env.example

# Local hardware diagnostics and smoke-test reports can contain device details
*-diagnostics.json
*-smoke-test.json
diagnostics.json

# Private support collection (contains this laptop's model, drivers and logs)
/Vivobook_X1605VA_Support_Bundle/
/Vivobook_X1605VA_Support_Bundle.zip

# Build outputs, downloaded installer, and packaged binaries
build/
dist/
release/*.exe
python-*-amd64.exe

# Keep the app's reproducible PyInstaller specification
*.spec
!MusicRGB-MusicWave.spec
